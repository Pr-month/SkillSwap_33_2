# Ports
NGINX_PORT=80
FRONTEND_PORT=3001
BACKEND_PORT=3002
WS_PORT=4000
POSTGRES_PORT=5432

# Backend
NODE_ENV=development
HASH_SALT=10
JWT_ACCESS_TOKEN=change_this_min_32_chars_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_TOKEN=change_this_min_32_chars_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_TOKEN=change_this_min_32_chars_secret
POSTGRES_USER=skillswap_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=skillswap_db
POSTGRES_SYNCHRONIZE=true
FRONTEND_URL=http://localhost
DISABLE_CSRF=true

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=noreply@example.com
MAIL_PASSWORD=change_this_password
MAIL_FROM="SkillSwap" <noreply@example.com>